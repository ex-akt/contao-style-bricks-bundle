<?php //Using section- and __inside is deprecated since Contao 5.3 and will be removed StyleBricks 2.0 ?>

<?php if ($this->content): ?>
<section id="<?= Contao\StringUtil::standardize($this->id, true) ?>" class="section-<?= Contao\StringUtil::standardize($this->id, true) ?>">
    <div class="inside section-<?= Contao\StringUtil::standardize($this->id, true) ?>__inside">
        <?= $this->content ?>
    </div>
</section>
<?php endif; ?>
