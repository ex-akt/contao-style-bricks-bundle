<?php $slugger = new Symfony\Component\String\Slugger\AsciiSlugger('de') ?>
<?php if ($this->content): ?>
<section id="<?= $slugger->slug($this->id)->lower() ?>" class="section-<?= $slugger->slug($this->id)->lower() ?>">
    <div class="inside section-<?= $slugger->slug($this->id)->lower() ?>__inside">
        <?= $this->content ?>
    </div>
</section>
<?php endif; ?>
